# Interpolation Docker Compose uniquement. Les réglages applicatifs sont dans
# backend/.env et frontend/.env.local (copiés depuis leurs exemples).
# Valeur publique de développement : changer avant toute exposition réseau.
POSTGRES_DB=campuspulse
POSTGRES_USER=campuspulse
# Compose insère ce mot de passe dans une URL : utiliser lettres, chiffres, _ et -.
# secrets.token_urlsafe(32) produit une valeur aléatoire compatible.
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000
SMTP_PORT=1025
MAILPIT_PORT=8025
# Adresse SMTP vue depuis les conteneurs (Mailpit par défaut).
# Pour SMTP externe : smtp.votre-fournisseur.example / 587, puis TLS et
# identifiants dans backend/.env. SMTP_PORT ci-dessus est le port hôte Mailpit.
COMPOSE_SMTP_HOST=mailpit
COMPOSE_SMTP_PORT=1025
