# Copier dans backend/.env. Ce fichier est chargé depuis son chemin absolu.
APP_NAME=CampusPulse
APP_ENV=development
APP_DEBUG=false

# PostgreSQL local ; Compose remplace l'hôte par postgres.
# Encoder les caractères spéciaux du mot de passe dans une URL (%40 pour @).
DATABASE_URL=postgresql+psycopg://campuspulse:change-me-local@localhost:5432/campuspulse
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]

# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
SESSION_COOKIE_NAME=campuspulse_session
CSRF_COOKIE_NAME=campuspulse_csrf
SESSION_EXPIRE_HOURS=24
COOKIE_SECURE=false
# Laisser vide en local ; même domaine frontend/API recommandé en production.
COOKIE_DOMAIN=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
PASSWORD_RESET_EXPIRE_MINUTES=30
INVITATION_EXPIRE_HOURS=48
# Inscription publique uniquement pour les étudiants des établissements actifs.
# Les autres rôles sont attribués par les administrateurs.
PUBLIC_REGISTRATION_ENABLED=true

# Vérification obligatoire des nouvelles inscriptions étudiantes par code e-mail.
# Générer un secret distinct : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vide : utilise SECRET_KEY. Ne jamais exposer ce secret dans le frontend.
OTP_SECRET_KEY=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Chemin privé hors du dossier frontend/public. Relatif au dossier backend.
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20

# Mailpit local : SMTP 1025, interface http://localhost:8025, sans identifiants.
# SMTP externe : port 587 + STARTTLS=true OU port 465 + SSL=true.
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_ALLOW_INSECURE=false
SMTP_FROM_EMAIL=noreply@campuspulse.test
SMTP_FROM_NAME=CampusPulse
SMTP_TIMEOUT_SECONDS=10
MAIL_MAX_ATTEMPTS=5
MAIL_POLL_SECONDS=5

# Seulement pour python -m app.seed, jamais utilisé automatiquement.
# Définir un mot de passe de démonstration personnel (12 caractères minimum).
DEMO_PASSWORD=
