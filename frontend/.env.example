# Copier vers frontend/.env.local en développement.
# URL publique du backend, appelée par le navigateur (jamais un nom Docker interne).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# En production, définir cette URL AVANT npm run build, puis reconstruire l'image.
# Utiliser le même domaine parent pour frontend et API afin de partager le cookie CSRF.
# Aucun secret SMTP, mot de passe ni secret de session dans ce fichier frontend.
